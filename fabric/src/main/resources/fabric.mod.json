{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [${mod_authors}],
  "contact": {
    "homepage": "${mod_display_url}"
  },
  "license": "${mod_license}",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.talhanation.recruits.fabric.RecruitsFabric"],
    "client": ["com.talhanation.recruits.fabric.RecruitsFabricClient"]
  },
  "mixins": [
    "mixins.${mod_id}.json",
    "mixins.${mod_id}.fabric.json"
  ],
  "accessWidener": "${mod_id}.accesswidener",
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "${minecraft_range}",
    "java": ">=${java_version}",
    "architectury": ">=${architectury_version}",
    "forgeconfigapiport": "*"
  }
}
